[raspberry_pis]
rpi-01 ansible_host=192.168.1.100
rpi-02 ansible_host=192.168.1.101
rpi-03 ansible_host=192.168.1.102

[raspberry_pis:vars]
ansible_user=pi
ansible_ssh_private_key_file=~/.ssh/id_rsa
ansible_python_interpreter=/usr/bin/python3

[production_rpis]
rpi-01

[development_rpis]
rpi-02
rpi-03

